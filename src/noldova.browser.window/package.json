{
  "name": "@noldova/browser.window",
  "version": "0.0.3",
  "description": "The browser module's window part: the page documents that show web pages in the window, the command that opens one, the status-bar item that says each agent's open pages, their controller and the tracker of the place the page shows in.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/browser.git",
    "directory": "src/noldova.browser.window"
  },
  "homepage": "https://github.com/noldova-com/browser#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/browser/issues"
  },
  "exports": {
    ".": "./src/api/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.js.map",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@noldova/ui.components.angular": "0.0.12",
    "@noldova/desktop.protocol": "0.0.6",
    "@noldova/desktop.window": "0.0.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@noldova/context.exceptions": ">=0.0.7 <0.1.0",
    "@noldova/context.json": ">=0.0.7 <0.1.0"
  }
}
