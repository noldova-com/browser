{
  "name": "@noldova/browser",
  "version": "0.0.3",
  "description": "The browser module for apps on Noldova Desktop: web pages in the window, and agent tools that read and act on them through permission requests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/browser.git",
    "directory": "src/noldova.browser"
  },
  "homepage": "https://github.com/noldova-com/browser#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/browser/issues"
  },
  "exports": {
    "./runtime": "./src/api/index.ts",
    "./window": "./src/api/window.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "module.json",
    "settings.json",
    "menus.json",
    "webViews.json",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noldova/browser.protocol": "0.0.3",
    "@noldova/browser.window": "0.0.3"
  },
  "peerDependencies": {
    "@noldova/desktop.protocol": ">=0.0.8 <0.1.0",
    "@noldova/desktop.runtime": ">=0.0.8 <0.1.0",
    "@noldova/context.exceptions": ">=0.0.7 <0.1.0",
    "@noldova/context.json": ">=0.0.7 <0.1.0"
  }
}
