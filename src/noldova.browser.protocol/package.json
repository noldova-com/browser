{
  "name": "@noldova/browser.protocol",
  "version": "0.0.8",
  "description": "The browser module's messages that its runtime and window parts exchange, as model classes that read and write their JSON, the tool names, and the rules both read alike: the kind of a URL's host and the sites on this computer or network.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noldova-com/browser.git",
    "directory": "src/noldova.browser.protocol"
  },
  "homepage": "https://github.com/noldova-com/browser#readme",
  "bugs": {
    "url": "https://github.com/noldova-com/browser/issues"
  },
  "exports": {
    ".": "./src/api/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.js.map",
    "src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@noldova/context.exceptions": ">=0.0.18 <0.1.0",
    "@noldova/context.json": ">=0.0.18 <0.1.0"
  }
}
